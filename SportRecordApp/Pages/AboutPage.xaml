<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportRecordApp.Pages.AboutPage"
             BackgroundColor="#FF9800"
             Title="关于"
             Shell.NavBarIsVisible="False">
    <VerticalStackLayout Padding="40" Spacing="30" VerticalOptions="Center">
        <Label 
            Text="运动打卡" 
            FontSize="32" 
            FontAttributes="Bold" 
            TextColor="White" 
            HorizontalOptions="Center" />
        
        <Label 
            Text="版本 1.0.3" 
            FontSize="20" 
            TextColor="White" 
            HorizontalOptions="Center" />
        
        <Label 
            Text="开发者：SuperYH" 
            FontSize="18" 
            TextColor="White" 
            HorizontalOptions="Center" />
        
        <Button 
            Text="使用说明" 
            FontSize="16" 
            BackgroundColor="#2196F3" 
            TextColor="White" 
            WidthRequest="120" 
            Clicked="OnInstructionsClicked" 
            HorizontalOptions="Center" 
            Margin="0,10,0,0" />
        
        <Button 
            Text="检查更新" 
            FontSize="16" 
            BackgroundColor="#4CAF50" 
            TextColor="White" 
            WidthRequest="120" 
            Clicked="OnCheckUpdateClicked" 
            HorizontalOptions="Center" 
            Margin="0,10,0,0" />
        
        <Button 
            Text="返回" 
            FontSize="16" 
            BackgroundColor="#9C27B0" 
            TextColor="White" 
            WidthRequest="120" 
            Clicked="OnBackClicked" 
            HorizontalOptions="Center" 
            Margin="0,10,0,0" />
    </VerticalStackLayout>
</ContentPage>