<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportRecordApp.Pages.TimerReminderPage"
             BackgroundColor="#FF9800"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Button 
            Grid.Row="0"
            Grid.Column="0"
            Text="← 返回"
            BackgroundColor="Transparent"
            TextColor="White"
            FontSize="16"
            HorizontalOptions="Start"
            Margin="10, 10, 0, 0"
            Clicked="OnBackClicked" />

        <VerticalStackLayout 
            Grid.Row="1"
            Grid.Column="0"
            Spacing="20"
            Padding="20">
            <Label 
                x:Name="ProjectNameLabel"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center" />
            <Label 
                Text="多功能设置"
                FontSize="18"
                TextColor="#E0E0E0"
                HorizontalOptions="Center" />
            
            <Border 
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                Padding="20"
                Margin="0, 20, 0, 0">
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label 
                            Text="定时喝水"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#333333" />
                        <Label 
                            x:Name="ReminderStatusLabel"
                            Text="已关闭"
                            FontSize="14"
                            TextColor="#999999" />
                    </VerticalStackLayout>
                    <Switch 
                        x:Name="DrinkWaterSwitch"
                        Grid.Column="1"
                        ThumbColor="#9C27B0"
                        OnColor="#FF9800"
                        OffColor="Gray"
                        VerticalOptions="Center"
                        Toggled="OnDrinkWaterSwitchToggled" />
                    <Button 
                        Grid.Column="2" 
                        Text="⋮" 
                        FontSize="24" 
                        FontAttributes="Bold" 
                        TextColor="#666666" 
                        BackgroundColor="Transparent" 
                        WidthRequest="40" 
                        HeightRequest="40" 
                        Padding="0" 
                        Clicked="OnMenuButtonClicked" 
                        VerticalOptions="Center" />
                </Grid>
            </Border>
            
            <Border 
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                Padding="20"
                Margin="0, 10, 0, 0">
                <Grid ColumnDefinitions="*, Auto, Auto">
                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                        <Label 
                            Text="心率广播"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#333333" />
                        <Label 
                            x:Name="HeartRateStatusLabel"
                            Text="已关闭"
                            FontSize="14"
                            TextColor="#999999" />
                    </VerticalStackLayout>
                    <Switch 
                        x:Name="HeartRateSwitch"
                        Grid.Column="1"
                        ThumbColor="#9C27B0"
                        OnColor="#FF9800"
                        OffColor="Gray"
                        VerticalOptions="Center"
                        Toggled="OnHeartRateSwitchToggled" />
                    <Button 
                        Grid.Column="2" 
                        Text="⋮" 
                        FontSize="24" 
                        FontAttributes="Bold" 
                        TextColor="#666666" 
                        BackgroundColor="Transparent" 
                        WidthRequest="40" 
                        HeightRequest="40" 
                        Padding="0" 
                        Clicked="OnHeartRateMenuButtonClicked" 
                        VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Grid 
            x:Name="DialogOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            BackgroundColor="#80000000"
            IsVisible="False">
            <Border 
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                Padding="20"
                WidthRequest="300"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <VerticalStackLayout Spacing="15">
                    <Label 
                        Text="定时设置"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#333333"
                        HorizontalOptions="Center" />
                    <Label 
                        Text="请输入提醒间隔时间"
                        FontSize="14"
                        TextColor="#666666"
                        HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="3*, *">
                        <Entry 
                            x:Name="TimeEntry"
                            Grid.Column="0"
                            Placeholder="输入时间"
                            Keyboard="Numeric"
                            FontSize="16"
                            HorizontalOptions="Fill" />
                        <Picker 
                            x:Name="UnitPicker"
                            Grid.Column="1"
                            FontSize="14"
                            HorizontalOptions="Fill"
                            Margin="5,0,0,0"
                            SelectedIndexChanged="OnUnitPickerSelectedIndexChanged">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>默认</x:String>
                                    <x:String>分钟</x:String>
                                    <x:String>小时</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button 
                            Grid.Column="0"
                            Text="取消"
                            BackgroundColor="#CCCCCC"
                            TextColor="Black"
                            Clicked="OnDialogCancelClicked" />
                        <Button 
                            Grid.Column="1"
                            Text="确定"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            Clicked="OnDialogConfirmClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid 
            x:Name="DeviceDialogOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            BackgroundColor="#80000000"
            IsVisible="False">
            <Border 
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                Padding="20"
                WidthRequest="320"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <VerticalStackLayout Spacing="15">
                    <Label 
                        Text="搜索设备"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#333333"
                        HorizontalOptions="Center" />
                    <Label 
                        x:Name="ScanningStatusLabel"
                        Text="正在搜索..."
                        FontSize="14"
                        TextColor="#666666"
                        HorizontalOptions="Center" />
                    <CollectionView 
                        x:Name="DeviceListView"
                        HeightRequest="200"
                        SelectionMode="Single"
                        SelectionChanged="OnDeviceListViewSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, *" Padding="10">
                                    <RadioButton 
                                        Grid.Column="0"
                                        GroupName="DeviceGroup"
                                        VerticalOptions="Center"
                                        IsChecked="{Binding IsSelected}" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                                        <Label 
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            TextColor="#333333" />
                                        <Label 
                                            Text="{Binding Address}"
                                            FontSize="12"
                                            TextColor="#999999" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button 
                            Grid.Column="0"
                            Text="取消"
                            BackgroundColor="#CCCCCC"
                            TextColor="Black"
                            Clicked="OnDeviceDialogCancelClicked" />
                        <Button 
                            Grid.Column="1"
                            Text="确定"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            Clicked="OnDeviceDialogConfirmClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid 
            x:Name="HeartRateMenuOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            BackgroundColor="Transparent"
            IsVisible="False">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnHeartRateMenuOverlayTapped" />
            </Grid.GestureRecognizers>
            <Border 
                BackgroundColor="White"
                StrokeShape="RoundRectangle 10"
                Padding="5"
                WidthRequest="160"
                VerticalOptions="Start"
                HorizontalOptions="End"
                Margin="0, 280, 20, 0">
                <VerticalStackLayout Spacing="5">
                    <Button 
                        Text="搜索设备"
                        BackgroundColor="Transparent"
                        TextColor="#333333"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Clicked="OnSearchDeviceMenuClicked" />
                    <Button 
                        Text="历史设备"
                        BackgroundColor="Transparent"
                        TextColor="#333333"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        Clicked="OnHistoryDeviceMenuClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid 
            x:Name="HistoryDeviceOverlay"
            Grid.Row="0"
            Grid.RowSpan="2"
            BackgroundColor="#80000000"
            IsVisible="False">
            <Border 
                BackgroundColor="White"
                StrokeShape="RoundRectangle 15"
                Padding="20"
                WidthRequest="320"
                VerticalOptions="Center"
                HorizontalOptions="Center">
                <VerticalStackLayout Spacing="15">
                    <Label 
                        Text="历史设备"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#333333"
                        HorizontalOptions="Center" />
                    <CollectionView 
                        x:Name="HistoryDeviceListView"
                        HeightRequest="200"
                        SelectionMode="Single"
                        SelectionChanged="OnHistoryDeviceListViewSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, *, Auto" Padding="10">
                                    <RadioButton 
                                        Grid.Column="0"
                                        GroupName="HistoryDeviceGroup"
                                        VerticalOptions="Center"
                                        IsChecked="{Binding IsSelected}" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0,0,0">
                                        <Label 
                                            Text="{Binding DisplayName}"
                                            FontSize="16"
                                            TextColor="#333333" />
                                        <Label 
                                            Text="{Binding Address}"
                                            FontSize="12"
                                            TextColor="#999999" />
                                    </VerticalStackLayout>
                                    <Button 
                                        Grid.Column="2" 
                                        Text="🗑" 
                                        FontSize="18" 
                                        TextColor="#FF5722" 
                                        BackgroundColor="Transparent" 
                                        WidthRequest="36" 
                                        HeightRequest="36" 
                                        Padding="0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteDeviceCommand}"
                                        CommandParameter="{Binding}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label 
                        x:Name="HistoryEmptyLabel"
                        Text="暂无历史设备"
                        FontSize="14"
                        TextColor="#999999"
                        HorizontalOptions="Center"
                        IsVisible="False" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button 
                            Grid.Column="0"
                            Text="取消"
                            BackgroundColor="#CCCCCC"
                            TextColor="Black"
                            Clicked="OnHistoryDeviceCancelClicked" />
                        <Button 
                            Grid.Column="1"
                            Text="连接"
                            BackgroundColor="#FF9800"
                            TextColor="White"
                            Clicked="OnHistoryDeviceConnectClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
