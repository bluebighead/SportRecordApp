<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SportRecordApp.Pages.CheckInDetailPage"
             BackgroundColor="#FF9800"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button 
            Grid.Row="0"
            Grid.Column="0"
            Text="← 返回"
            BackgroundColor="Transparent"
            TextColor="White"
            FontSize="16"
            HorizontalOptions="Start"
            Margin="10, 10, 0, 0"
            Clicked="OnBackClicked" />

        <Button 
            x:Name="ShareButton"
            Grid.Row="0"
            Grid.Column="1"
            Text="分享"
            BackgroundColor="Transparent"
            TextColor="White"
            FontSize="16"
            HorizontalOptions="End"
            Margin="0, 10, 10, 0"
            Clicked="OnShareClicked" />

        <VerticalStackLayout 
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Spacing="10"
            Padding="20">
            <Label 
                x:Name="ProjectNameLabel"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center" />
            <Label 
                x:Name="CheckInDaysLabel"
                FontSize="18"
                TextColor="#E0E0E0"
                HorizontalOptions="Center" />
            <Button 
                x:Name="ViewToggleButton"
                Text="切换到日历视图"
                BackgroundColor="#FFA726"
                TextColor="White"
                FontSize="14"
                HorizontalOptions="Center"
                Padding="10, 5, 10, 5"
                Clicked="OnViewToggleClicked" />
        </VerticalStackLayout>

        <CollectionView 
            x:Name="CheckInTimesList"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="20, 10, 20, 20">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border 
                        BackgroundColor="White"
                        StrokeShape="RoundRectangle 10"
                        Padding="15"
                        Margin="0, 0, 0, 10">
                        <Label 
                            Text="{Binding}"
                            FontSize="16"
                            TextColor="#333333"
                            HorizontalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid 
            x:Name="CalendarView"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="20, 10, 20, 20"
            IsVisible="False">
            <ScrollView>
                <VerticalStackLayout>
                    <!-- 年月切换控件 -->
                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        Margin="0, 0, 0, 10">
                        <Button
                            x:Name="PrevYearButton"
                            Text="←年"
                            BackgroundColor="#FFA726"
                            TextColor="White"
                            FontSize="14"
                            Clicked="OnPrevYearClicked" />
                        <Button
                            x:Name="PrevMonthButton"
                            Text="←月"
                            BackgroundColor="#FFA726"
                            TextColor="White"
                            FontSize="14"
                            Grid.Column="1"
                            HorizontalOptions="Start"
                            Clicked="OnPrevMonthClicked" />
                        <Label
                            x:Name="CurrentMonthYearLabel"
                            Grid.Column="1"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                        <Button
                            x:Name="NextMonthButton"
                            Text="月→"
                            BackgroundColor="#FFA726"
                            TextColor="White"
                            FontSize="14"
                            Grid.Column="1"
                            HorizontalOptions="End"
                            Clicked="OnNextMonthClicked" />
                        <Button
                            x:Name="NextYearButton"
                            Text="年→"
                            BackgroundColor="#FFA726"
                            TextColor="White"
                            FontSize="14"
                            Grid.Column="2"
                            Clicked="OnNextYearClicked" />
                    </Grid>
                    
                    <Grid 
                        x:Name="CalendarGrid"
                        ColumnDefinitions="*,*,*,*,*,*,*"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>
